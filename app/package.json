{
  "name": "mycard-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "MyCard — application React (web, iOS et Android via Capacitor)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/publish.mjs",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "cap:android": "npm run build && cap sync android && cap open android"
  },
  "dependencies": {
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "@capacitor/cli": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/android": "8.6.0"
  }
}
