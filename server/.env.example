# Copie ce fichier en « .env » (jamais dans le dépôt) ou exporte ces variables avant de lancer le serveur.

# ID client Google (public) : « xxxx.apps.googleusercontent.com ». Sans lui, le bouton Google reste désactivé.
GOOGLE_CLIENT_ID=

# Port d'écoute (8080 par défaut).
PORT=8080

# Secret qui signe les cookies de session (32 caractères ou plus). Facultatif en local :
# s'il est absent, un secret est créé une fois dans server/data/session.key.
SESSION_SECRET=

# Mettre 1 si le site est servi en HTTPS (le cookie ne voyagera alors qu'en HTTPS).
COOKIE_SECURE=0

# Durée de la session en jours (30 par défaut).
SESSION_DAYS=30
